# Copy to .env and fill in. Never commit .env — it is gitignored.

# LiveKit Cloud (livekit.io) — required for the browser call path
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Speech to text, and Deepgram Aura voices for TTS (deepgram.com)
DEEPGRAM_API_KEY=

# Google AI Studio, for the Gemini LLM providers (aistudio.google.com)
GOOGLE_API_KEY=

# ElevenLabs TTS (elevenlabs.io)
ELEVEN_API_KEY=

# Only needed if a config uses the local Ollama LLM provider.
# Defaults to http://localhost:11434/v1 when unset.
# OLLAMA_BASE_URL=
